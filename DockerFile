FROM public.ecr.aws/lambda/python:3.10

# The AWS Lambda base image is minimal and doesn't include a C compiler.
# Packages like scikit-learn need one to build from source, so we install gcc.
RUN yum install -y gcc

# Copy requirements.txt first to leverage Docker layer caching.
COPY requirements.txt .
RUN pip install -r requirements.txt

# Copy the application file from the 'app' directory into the Lambda task root.
COPY ./app/main.py .

# Copy the pre-built FAISS vector index.
COPY ./faiss_index/ ./faiss_index/

# The CMD parameter is set as the handler for the Lambda function.
# The format is "<filename>.<handler_function_name>".
# Our file is main.py and our handler function is handler.
CMD [ "main.handler" ]